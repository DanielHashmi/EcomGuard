# EcomGuard Environment Variables (Template)

# --- Provider switch: groq (spec default, GPT-OSS-120B) or gemini ---
LLM_PROVIDER=groq

# Leave MODEL_NAME blank to use the provider's default
# (Groq -> openai/gpt-oss-120b, Gemini -> gemini-2.0-flash).
MODEL_NAME=

# Free Groq key: https://console.groq.com/
GROQ_API_KEY=gsk_your_key_here

# Google AI Studio key (must start with AIza): https://aistudio.google.com/apikey
GEMINI_API_KEY=

PORT=8000
